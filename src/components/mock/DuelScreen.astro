---
/** Illustrative in-app "duel" screen (decorative; wrapped aria-hidden). */
const options = [
  { v: "352", state: "correct" },
  { v: "362", state: "idle" },
  { v: "342", state: "idle" },
  { v: "358", state: "idle" },
];
const pips = Array.from({ length: 10 }, (_, i) => i);
---

<div class="flex h-full w-full flex-col bg-cream p-4 font-sans">
  <!-- top bar -->
  <div class="flex items-center justify-between">
    <span class="rounded-full bg-ink px-2.5 py-1 text-[11px] font-bold text-cream">Gold II</span>
    <span class="font-num text-lg font-bold text-brand">0:08</span>
  </div>

  <!-- players -->
  <div class="mt-4 flex items-center justify-between gap-2">
    <div class="flex flex-col items-center gap-1">
      <div class="grid h-12 w-12 place-items-center rounded-2xl font-display text-lg font-extrabold text-white" style="background:var(--gradient-brand);">Y</div>
      <span class="text-[11px] font-semibold text-ink">You</span>
      <span class="font-num text-[11px] text-muted-2">1,480</span>
    </div>
    <div class="grid h-9 w-9 place-items-center rounded-full font-display text-xs font-extrabold text-white shadow-md" style="background:var(--color-duel);">VS</div>
    <div class="flex flex-col items-center gap-1">
      <div class="grid h-12 w-12 place-items-center rounded-2xl bg-ink font-display text-lg font-extrabold text-cream">R</div>
      <span class="text-[11px] font-semibold text-ink">Rohit</span>
      <span class="font-num text-[11px] text-muted-2">1,504</span>
    </div>
  </div>

  <!-- progress -->
  <div class="mt-5 flex items-center justify-between">
    <span class="text-[11px] font-bold uppercase tracking-wide text-muted-2">Q4 / 10</span>
    <div class="flex gap-1">
      {pips.map((i) => <span class:list={["h-1.5 w-1.5 rounded-full", i < 3 ? "bg-brand" : i === 3 ? "bg-amber" : "bg-ink/15"]} />)}
    </div>
  </div>

  <!-- question -->
  <div class="mt-3 rounded-3xl bg-white p-5 text-center shadow-[0_10px_24px_rgba(40,20,10,.08)]">
    <span class="text-[10px] font-bold uppercase tracking-wider text-muted-2">Solve fast</span>
    <div class="mt-1 font-num text-4xl font-bold text-ink">32 × 11</div>
    <div class="font-num text-2xl font-bold text-brand">= ?</div>
  </div>

  <!-- answers -->
  <div class="mt-4 grid grid-cols-2 gap-2.5">
    {
      options.map((o) => (
        <div
          class:list={[
            "grid place-items-center rounded-2xl py-3.5 font-num text-lg font-bold",
            o.state === "correct" ? "bg-brand text-white shadow-[0_8px_18px_rgba(244,63,94,.3)]" : "bg-white text-ink ring-1 ring-ink/8",
          ]}
        >
          {o.v}
        </div>
      ))
    }
  </div>

  <div class="mt-auto pt-4 text-center text-[11px] font-medium text-muted-2">Rohit is answering…</div>
</div>
