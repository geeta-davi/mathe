---
/**
 * Device frame that wraps a screen mock in a slot. Decorative.
 */
interface Props {
  class?: string;
  float?: boolean;
}
const { class: cls = "", float = false } = Astro.props;
---

<div
  class:list={["phone relative mx-auto w-full max-w-[300px]", cls]}
  style={float ? "animation:float 6s ease-in-out infinite;" : ""}
  aria-hidden="true"
>
  <div
    class="relative rounded-[44px] bg-ink p-2.5 shadow-[0_30px_70px_-20px_rgba(40,20,10,.5)]"
    style="aspect-ratio:300/620;"
  >
    <!-- notch -->
    <div class="absolute left-1/2 top-3 z-20 h-6 w-28 -translate-x-1/2 rounded-full bg-ink"></div>
    <div class="relative h-full w-full overflow-hidden rounded-[36px]">
      <slot />
    </div>
  </div>
</div>
