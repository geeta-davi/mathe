---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import Logo from "../ui/Logo.astro";
import StoreBadges from "../ui/StoreBadges.astro";
import { COMPANY, SOCIAL } from "../../consts";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const columns = [
  {
    heading: "footer.product",
    links: [
      { key: "link.features", path: "features" },
      { key: "link.how", path: "how-it-works" },
      { key: "link.download", path: "download" },
    ],
  },
  {
    heading: "footer.company",
    links: [
      { key: "link.about", path: "about" },
      { key: "link.support", path: "support" },
      { key: "link.contact", path: "contact" },
    ],
  },
  {
    heading: "footer.legal",
    links: [
      { key: "link.privacy", path: "privacy" },
      { key: "link.terms", path: "terms" },
      { key: "link.cookies", path: "cookies" },
    ],
  },
] as const;
---

<footer class="mt-24 bg-ink text-cream/80">
  <div class="shell py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2.5">
          <Logo size={38} wordmark={false} />
          <span class="font-display text-2xl font-extrabold text-cream">mathe</span>
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-cream/60">{t("footer.tagline")}</p>
        <div class="mt-5">
          <StoreBadges iosLabel={t("cta.appStore")} androidLabel={t("cta.googlePlay")} />
        </div>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={t(col.heading)}>
            <h2 class="font-display text-sm font-bold uppercase tracking-wide text-cream/50">{t(col.heading)}</h2>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a href={getRelativeLocaleUrl(lang, l.path)} class="text-[15px] text-cream/75 hover:text-cream">
                    {t(l.key)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <p class="font-mono text-xs text-cream/50">© {year} {COMPANY} · mathe.games · {t("footer.rights")}</p>
      <div class="flex items-center gap-4">
        <a href={SOCIAL.x} aria-label="X" class="text-cream/60 hover:text-cream">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.1 8.1L23 22h-6.6l-5.2-6.8L5.3 22H2l7.6-8.7L1.5 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.8L7.3 4H5.4l12.3 16Z"/></svg>
        </a>
        <a href={SOCIAL.instagram} aria-label="Instagram" class="text-cream/60 hover:text-cream">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href={SOCIAL.youtube} aria-label="YouTube" class="text-cream/60 hover:text-cream">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.8-1.8C19.3 5 12 5 12 5s-7.3 0-8.8.5A2.5 2.5 0 0 0 1.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.8 1.8C4.7 19 12 19 12 19s7.3 0 8.8-.5a2.5 2.5 0 0 0 1.8-1.8C23 15.2 23 12 23 12Zm-13 3V9l5.2 3-5.2 3Z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
