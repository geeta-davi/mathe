---
/**
 * Zero-JS language switcher (native <details> dropdown). Each option links to
 * the same page in the target locale; missing pages fall back to English.
 */
import { getLangFromUrl, useTranslations, switchLocalePath } from "../../i18n/utils";
import { languages, localeNames } from "../../i18n/ui";

const current = getLangFromUrl(Astro.url);
const t = useTranslations(current);
---

<details class="lang relative">
  <summary
    class="flex items-center gap-1.5 cursor-pointer list-none rounded-full px-3 py-2 text-sm font-semibold text-ink/80 hover:text-ink hover:bg-ink/5"
    aria-label={t("lang.label")}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" />
    </svg>
    <span class="uppercase">{current}</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <ul
    class="absolute right-0 mt-2 min-w-[160px] rounded-2xl bg-white p-1.5 shadow-[0_16px_40px_rgba(40,20,10,.16)] ring-1 ring-ink/5 z-50"
  >
    {
      languages.map((l) => (
        <li>
          <a
            href={switchLocalePath(Astro.url, l)}
            hreflang={l}
            aria-current={l === current ? "true" : undefined}
            class:list={[
              "flex items-center justify-between rounded-xl px-3 py-2 text-sm font-medium hover:bg-blush/60",
              l === current ? "text-brand font-semibold" : "text-ink/80",
            ]}
          >
            {localeNames[l]}
            <span class="uppercase text-xs text-muted-2">{l}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang > summary::-webkit-details-marker { display: none; }
  .lang[open] > summary svg:last-child { transform: rotate(180deg); }
  .lang > summary svg:last-child { transition: transform 0.15s; }
</style>
