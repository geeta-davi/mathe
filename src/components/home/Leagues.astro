---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import OperatorField from "../ui/OperatorField.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tiers = [
  { key: "leagues.bronze", color: "#C08457", range: "0 – 999", active: false },
  { key: "leagues.silver", color: "#B8C0C8", range: "1,000 – 1,399", active: false },
  { key: "leagues.gold", color: "#F59E0B", range: "1,400 – 1,899", active: true },
  { key: "leagues.diamond", color: "#22D3EE", range: "1,900+", active: false },
] as const;
---

<section class="relative overflow-hidden bg-ink py-20 text-cream md:py-28">
  <OperatorField tone="dark" />
  <div class="pointer-events-none absolute left-1/2 top-1/3 h-96 w-96 -translate-x-1/2 rounded-full opacity-30 blur-3xl" style="background:radial-gradient(circle,#F43F5E,transparent 70%);"></div>

  <div class="shell relative">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-4xl font-extrabold text-cream sm:text-5xl">{t("leagues.title")}</h2>
      <p class="mt-4 text-lg text-cream/70">{t("leagues.subtitle")}</p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        tiers.map((tier) => (
          <div
            class:list={[
              "relative rounded-3xl p-6 ring-1 transition-transform",
              tier.active ? "bg-white/10 ring-white/25 -translate-y-1" : "bg-white/5 ring-white/10",
            ]}
          >
            {tier.active && (
              <span class="absolute right-4 top-4 rounded-full bg-brand px-2.5 py-0.5 text-[10px] font-bold uppercase text-white">You</span>
            )}
            <span class="grid h-12 w-12 place-items-center rounded-2xl" style={`background:${tier.color}26;color:${tier.color};`}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 21h8M12 17v4" /><path d="M7 4h10v4a5 5 0 0 1-10 0z" /><path d="M7 5H4v1a4 4 0 0 0 3 4M17 5h3v1a4 4 0 0 1-3 4" />
              </svg>
            </span>
            <h3 class="mt-4 font-display text-xl font-bold text-cream">{t(tier.key)}</h3>
            <p class="mt-1 font-num text-sm text-cream/60">{tier.range}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-cream/85 ring-1 ring-white/15">
        <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>{t("leagues.promo")}
      </span>
    </div>
  </div>
</section>
