---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
  heading?: boolean;
}
const { heading = true } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
  { n: "1", title: "how.step1.title", desc: "how.step1.desc" },
  { n: "2", title: "how.step2.title", desc: "how.step2.desc" },
  { n: "3", title: "how.step3.title", desc: "how.step3.desc" },
  { n: "4", title: "how.step4.title", desc: "how.step4.desc" },
] as const;
---

<section class="bg-cream py-20 md:py-28">
  <div class="shell">
    {
      heading && (
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="font-display text-4xl font-extrabold text-ink sm:text-5xl">{t("how.title")}</h2>
          <p class="mt-4 text-lg text-muted">{t("how.subtitle")}</p>
        </div>
      )
    }

    <ol class:list={["relative grid gap-10 md:grid-cols-4 md:gap-6", heading ? "mt-16" : "mt-4"]}>
      <!-- connector -->
      <div class="pointer-events-none absolute left-0 right-0 top-7 hidden h-0.5 bg-linear-to-r from-brand/30 via-amber/30 to-violet/30 md:block"></div>
      {
        steps.map((s) => (
          <li class="relative flex flex-col items-center text-center md:items-start md:text-left">
            <span class="grid h-14 w-14 place-items-center rounded-2xl font-display text-2xl font-extrabold text-white shadow-[0_8px_18px_rgba(244,63,94,.28)]" style="background:var(--gradient-brand);">
              {s.n}
            </span>
            <h3 class="mt-5 font-display text-xl font-bold text-ink">{t(s.title)}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{t(s.desc)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
