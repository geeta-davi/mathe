---
/**
 * The level ladder.
 *
 * Replaces the old `Leagues` band, which advertised a rating ladder
 * (Bronze→Diamond, "top 8 promote each week") for a ranked-league system that
 * does not exist — there is no Elo, no matchmaking and no weekly promotion.
 *
 * What the app actually has: admin-authored levels that unlock one at a time,
 * each verified solvable and graded 1–4 for difficulty. That grading is what
 * these four tiers show.
 */
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tiers = [
  { key: "ladder.d1", color: "#16A34A", bars: 1 },
  { key: "ladder.d2", color: "#F59E0B", bars: 2 },
  { key: "ladder.d3", color: "#F43F5E", bars: 3 },
  { key: "ladder.d4", color: "#5B3DF5", bars: 4 },
] as const;
---

<section class="relative overflow-hidden bg-ink py-20 text-cream md:py-28">
  <div
    class="pointer-events-none absolute left-1/2 top-1/3 h-96 w-96 -translate-x-1/2 rounded-full opacity-30 blur-3xl"
    style="background:radial-gradient(circle,#F43F5E,transparent 70%);"
  >
  </div>

  <div class="shell relative">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-4xl font-extrabold text-cream sm:text-5xl">{t("ladder.title")}</h2>
      <p class="mt-4 text-lg text-cream/70">{t("ladder.subtitle")}</p>
    </div>

    <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        tiers.map((tier, i) => (
          <li class="relative rounded-3xl bg-white/5 p-6 ring-1 ring-white/10">
            <span class="font-num text-xs font-bold uppercase tracking-wide text-cream/40">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="mt-3 flex items-end gap-1" aria-hidden="true">
              {Array.from({ length: 4 }).map((_, b) => (
                <span
                  class="w-3 rounded-sm"
                  style={`height:${(b + 1) * 6}px;background:${b < tier.bars ? tier.color : "rgba(255,255,255,.15)"};`}
                />
              ))}
            </div>
            <h3 class="mt-4 font-display text-xl font-bold text-cream">{t(tier.key)}</h3>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-cream/85 ring-1 ring-white/15"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>{t("ladder.note")}
      </span>
    </div>
  </div>
</section>
