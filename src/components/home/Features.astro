---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
  heading?: boolean;
}
const { heading = true } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  // Grid — handcrafted, uniquely-solvable levels.
  { title: "feat.levels.title", desc: "feat.levels.desc", color: "#5B3DF5", paths: ["M3 3h18v18H3z", "M9 3v18M15 3v18", "M3 9h18M3 15h18"] },
  // Flame — the daily streak.
  { title: "feat.streak.title", desc: "feat.streak.desc", color: "#F43F5E", paths: ["M12 3s5 4 5 9a5 5 0 0 1-10 0c0-2 1-3.5 2-4 0 1.5 1 2 1.5 2 1.5 0 .5-4 1.5-7z"] },
  // Bars — per-level times and the global ladder.
  { title: "feat.leaderboard.title", desc: "feat.leaderboard.desc", color: "#F59E0B", paths: ["M4 20V11M10 20V5M16 20v-6M2 20h18"] },
  // Bulb — hints derived from the player's live board.
  { title: "feat.hints.title", desc: "feat.hints.desc", color: "#22D3EE", paths: ["M9 18h6", "M10 22h4", "M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"] },
  // Layers — the growing game catalog.
  { title: "feat.catalog.title", desc: "feat.catalog.desc", color: "#16A34A", paths: ["m12 2 9 5-9 5-9-5 9-5z", "m3 12 9 5 9-5", "m3 17 9 5 9-5"] },
  // Heart — free, guest-first, deletable.
  { title: "feat.free.title", desc: "feat.free.desc", color: "#241712", paths: ["M20.8 6.6a5 5 0 0 0-7.1 0L12 8.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 22l8.8-8.3a5 5 0 0 0 0-7.1z"] },
] as const;
---

<section class="shell py-20 md:py-28">
  {
    heading && (
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-4xl font-extrabold text-ink sm:text-5xl">{t("features.title")}</h2>
        <p class="mt-4 text-lg text-muted">{t("features.subtitle")}</p>
      </div>
    )
  }

  <div class:list={["grid gap-5 sm:grid-cols-2 lg:grid-cols-3", heading ? "mt-14" : ""]}>
    {
      features.map((f) => (
        <article class="group rounded-3xl bg-white p-7 ring-1 ring-ink/5 transition-transform duration-200 hover:-translate-y-1 hover:shadow-[0_20px_44px_rgba(40,20,10,.1)]">
          <span
            class="grid h-12 w-12 place-items-center rounded-2xl"
            style={`background:${f.color}1a;color:${f.color};`}
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {f.paths.map((d) => <path d={d} />)}
            </svg>
          </span>
          <h3 class="mt-5 font-display text-xl font-bold text-ink">{t(f.title)}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-muted">{t(f.desc)}</p>
        </article>
      ))
    }
  </div>
</section>
