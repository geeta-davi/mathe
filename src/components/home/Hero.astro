---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import PuzzleField from "../ui/PuzzleField.astro";
import StoreBadges from "../ui/StoreBadges.astro";
import PhoneMock from "../mock/PhoneMock.astro";
import ZipScreen from "../mock/ZipScreen.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const titleLines = t("hero.title").split("\n");
---

<section class="relative overflow-hidden bg-paper">
  <PuzzleField tone="light" />
  <!-- warm glow -->
  <div class="pointer-events-none absolute -top-32 right-0 h-[420px] w-[420px] rounded-full opacity-40 blur-3xl" style="background:radial-gradient(circle,#FB7185,transparent 70%);"></div>

  <div class="shell relative grid items-center gap-12 py-16 md:grid-cols-2 md:py-24">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full bg-white/70 px-3.5 py-1.5 text-xs font-semibold text-brand ring-1 ring-brand/15">
        <span class="h-1.5 w-1.5 rounded-full bg-brand"></span>{t("hero.badge")}
      </span>

      <h1 class="mt-5 font-display text-5xl font-extrabold leading-[1.02] text-ink sm:text-6xl">
        {titleLines.map((line, i) => (<>{i > 0 && <br />}<span>{line}</span></>))}
      </h1>

      <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">{t("hero.subtitle")}</p>

      <div class="mt-8">
        <StoreBadges size="lg" iosLabel={t("cta.appStore")} androidLabel={t("cta.googlePlay")} />
      </div>
      <p class="mt-4 text-sm text-muted-2">{t("hero.note")}</p>
    </div>

    <div class="relative">
      {/* Floating puzzle tiles. These were "7", "=" and "VS" — an arithmetic
          operand, an equals sign and a duel badge, none of which exist in the
          app. Now: a Zip checkpoint, a path corner and a Cat & Seek cat. */}
      <div class="absolute -left-2 top-6 z-10 grid h-14 w-14 rotate-[-8deg] place-items-center rounded-2xl bg-amber font-num text-2xl font-extrabold text-white shadow-lg" style="animation:float 4s ease-in-out infinite;">3</div>
      <div class="absolute -right-1 top-1/3 z-10 grid h-12 w-12 rotate-[10deg] place-items-center rounded-xl bg-aqua font-display text-xl font-extrabold text-white shadow-lg" style="animation:float 5s ease-in-out .5s infinite;">⌐</div>
      <div class="absolute bottom-8 -left-3 z-10 grid h-12 w-12 rotate-[6deg] place-items-center rounded-xl bg-violet text-xl leading-none shadow-lg" style="animation:float 4.5s ease-in-out .2s infinite;">🐱</div>
      <PhoneMock float>
        <ZipScreen />
      </PhoneMock>
    </div>
  </div>
</section>
