---
import OperatorField from "./OperatorField.astro";
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title, subtitle, eyebrow } = Astro.props;
---

<section class="relative overflow-hidden bg-paper">
  <OperatorField tone="light" />
  <div class="shell relative py-16 text-center md:py-20">
    {eyebrow && <p class="font-display text-sm font-bold uppercase tracking-wider text-brand">{eyebrow}</p>}
    <h1 class="mx-auto max-w-3xl font-display text-4xl font-extrabold text-ink sm:text-5xl">{title}</h1>
    {subtitle && <p class="mx-auto mt-4 max-w-xl text-lg text-muted">{subtitle}</p>}
  </div>
</section>
