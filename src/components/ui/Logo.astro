---
/**
 * mathe logo — gradient rounded square with a bold "m", optional wordmark.
 * Sizes scale the tile radius the same way the brand kit does.
 */
interface Props {
  size?: number;
  wordmark?: boolean;
  href?: string;
  class?: string;
}
const { size = 40, wordmark = true, href, class: cls = "" } = Astro.props;
const radius = Math.round(size * 0.31);
const glyph = Math.round(size * 0.6);
const Tag = href ? "a" : "div";
---

<Tag
  {...href ? { href } : {}}
  class={`inline-flex items-center gap-2.5 ${cls}`}
  aria-label="mathe"
>
  <span
    class="grid place-items-center text-white font-display font-extrabold shrink-0"
    style={`width:${size}px;height:${size}px;border-radius:${radius}px;font-size:${glyph}px;background:var(--gradient-brand);box-shadow:0 6px 16px rgba(244,63,94,.32);line-height:1;`}
  >m</span>
  {
    wordmark && (
      <span
        class="font-display font-extrabold text-ink leading-none"
        style={`font-size:${Math.round(size * 0.62)}px;`}
      >mathe</span>
    )
  }
</Tag>
