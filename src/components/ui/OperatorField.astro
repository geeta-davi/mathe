---
/**
 * Decorative floating math-operator background. Purely ornamental.
 * `tone` sets glyph color against light or dark/gradient surfaces.
 */
interface Props {
  tone?: "light" | "dark" | "onBrand";
  class?: string;
}
const { tone = "light", class: cls = "" } = Astro.props;

const color =
  tone === "onBrand"
    ? "rgba(255,255,255,.16)"
    : tone === "dark"
      ? "rgba(255,255,255,.10)"
      : "rgba(36,23,18,.06)";

// position, glyph, size(px)
const glyphs = [
  { t: "8%", l: "6%", g: "+", s: 46 },
  { t: "22%", l: "88%", g: "×", s: 38 },
  { t: "62%", l: "3%", g: "÷", s: 40 },
  { t: "78%", l: "80%", g: "−", s: 44 },
  { t: "44%", l: "50%", g: "=", s: 34 },
  { t: "12%", l: "60%", g: "√", s: 30 },
  { t: "86%", l: "38%", g: "%", s: 30 },
];
---

<div class={`pointer-events-none absolute inset-0 overflow-hidden ${cls}`} aria-hidden="true">
  {
    glyphs.map((x, i) => (
      <span
        class="absolute font-display font-extrabold select-none"
        style={`top:${x.t};left:${x.l};font-size:${x.s}px;color:${color};animation:float ${3 + (i % 3)}s ease-in-out ${i * 0.3}s infinite;`}
      >
        {x.g}
      </span>
    ))
  }
</div>
