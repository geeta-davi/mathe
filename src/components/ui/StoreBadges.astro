---
/**
 * App Store + Google Play badges (self-drawn, on-brand). Links come from consts.ts.
 *
 * The two badges are deliberately NOT symmetrical. Android points at the live
 * listing (`games.mathe`, public since 2026-08-14). iOS has no listing at all —
 * `STORE_LINKS.ios` is null — so it renders as a NON-interactive "coming soon"
 * badge.
 *
 * That asymmetry is the point: this component previously rendered
 * `<a href={STORE_LINKS.ios}>` unconditionally, which with a null href produced
 * a button that looked exactly like the working one and did nothing when
 * tapped. consts.ts already documented the intended behaviour ("`ios: null`
 * makes StoreBadges render a 'coming soon' badge"); only the component
 * disagreed. If an App Store listing ever ships, set `STORE_LINKS.ios` and the
 * live branch below takes over with no other change.
 */
import { STORE_LINKS } from "../../consts";

interface Props {
  /** Localized. Doubles as the visible label while iOS is unreleased. */
  iosLabel?: string;
  androidLabel?: string;
  size?: "md" | "lg";
  class?: string;
}
const {
  iosLabel = "Coming soon to iOS",
  androidLabel = "Get it on Google Play",
  size = "md",
  class: cls = "",
} = Astro.props;

const h = size === "lg" ? "h-[54px]" : "h-[46px]";
const pad = size === "lg" ? "px-5" : "px-4";
const big = size === "lg" ? "text-[19px]" : "text-[16px]";
const small = size === "lg" ? "text-[11px]" : "text-[10px]";

const base = `inline-flex items-center gap-3 rounded-2xl ${pad} ${h}`;
const live = `${base} bg-ink text-white transition-transform duration-150 hover:-translate-y-0.5`;
/** Muted, non-interactive, and not focusable — there is nowhere to go yet. */
const soon = `${base} bg-ink/40 text-white/90 cursor-default select-none`;

const appleIcon =
  "M17.6 13.7c0-2.5 2-3.7 2.1-3.8-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.6.9-.8 0-1.9-.9-3.1-.8-1.6 0-3 .9-3.8 2.4-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.2 0 2-1.1 2.8-2.3.9-1.3 1.2-2.6 1.3-2.6-.1 0-2.5-1-2.5-3.7zM15.1 5.3c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.8 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2.1-.5 2.8-1.3z";
---

<div class={`flex flex-wrap items-center gap-3 ${cls}`}>
  {
    STORE_LINKS.ios ? (
      <a href={STORE_LINKS.ios} class={live} aria-label={iosLabel}>
        <svg width="22" height="26" viewBox="0 0 22 26" fill="currentColor" aria-hidden="true">
          <path d={appleIcon} />
        </svg>
        <span class="flex flex-col leading-tight text-left">
          <span class={`${small} opacity-80`}>Download on the</span>
          <span class={`${big} font-semibold -mt-0.5`}>App Store</span>
        </span>
      </a>
    ) : (
      <span class={soon} aria-label={iosLabel}>
        <svg width="22" height="26" viewBox="0 0 22 26" fill="currentColor" aria-hidden="true">
          <path d={appleIcon} />
        </svg>
        <span class="flex flex-col leading-tight text-left">
          <span class={`${small} opacity-80`}>App Store</span>
          <span class={`${big} font-semibold -mt-0.5`}>{iosLabel}</span>
        </span>
      </span>
    )
  }

  <a href={STORE_LINKS.android} class={live} aria-label={androidLabel}>
    <svg width="22" height="24" viewBox="0 0 22 24" aria-hidden="true">
      <path d="M2 1.2 12.8 12 2 22.8c-.4-.3-.7-.8-.7-1.4V2.6c0-.6.3-1.1.7-1.4z" fill="#22D3EE"/>
      <path d="M16.3 8.4 12.8 12 2 1.2c.5-.3 1.1-.3 1.7 0l12.6 7.2z" fill="#F43F5E"/>
      <path d="M16.3 15.6 3.7 22.8c-.6.3-1.2.3-1.7 0L12.8 12l3.5 3.6z" fill="#F59E0B"/>
      <path d="M20.7 10.6c.7.4 1 1 1 1.4s-.3 1-1 1.4l-2.8 1.6L14.3 12l3.6-3.4 2.8 2z" fill="#FB7185"/>
    </svg>
    <span class="flex flex-col leading-tight text-left">
      <span class={`${small} opacity-80`}>GET IT ON</span>
      <span class={`${big} font-semibold -mt-0.5`}>Google Play</span>
    </span>
  </a>
</div>
