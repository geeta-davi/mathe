---
// Root entry for "/". Redirects to the default locale (/en/).
// The refresh/link targets are RELATIVE so this works on localhost and in
// production; the canonical stays absolute for crawlers.
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang } from "../i18n/ui";
const target = getRelativeLocaleUrl(defaultLang, ""); // "/en/"
const canonical = getAbsoluteLocaleUrl(defaultLang, ""); // "https://mathe.games/en/"
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex" />
    <title>mathe</title>
  </head>
  <body>
    <a href={target}>Continue to mathe</a>
  </body>
</html>
