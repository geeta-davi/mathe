---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeStaticPaths, getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import PageHeader from "../../components/ui/PageHeader.astro";
import Button from "../../components/ui/Button.astro";
import { faq } from "../../i18n/faq";

export const getStaticPaths = () => localeStaticPaths();

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const items = faq[lang];
const breadcrumbs = [
  { name: "mathe", item: getAbsoluteLocaleUrl(lang, "") },
  { name: t("nav.support"), item: getAbsoluteLocaleUrl(lang, "support") },
];
---

<BaseLayout pageKey="support" path="support" breadcrumbs={breadcrumbs}>
  <PageHeader title={t("support.title")} subtitle={t("support.subtitle")} eyebrow={t("nav.support")} />

  <section class="shell py-14 md:py-20">
    <div class="mx-auto max-w-3xl">
      <ul class="space-y-3">
        {
          items.map((item) => (
            <li class="overflow-hidden rounded-2xl bg-white ring-1 ring-ink/5">
              <details class="faq group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-lg font-bold text-ink">
                  {item.q}
                  <svg class="shrink-0 text-brand transition-transform group-open:rotate-45" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                </summary>
                <div class="px-5 pb-5 text-[15px] leading-relaxed text-muted">{item.a}</div>
              </details>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-col items-center gap-4 rounded-3xl bg-cream p-8 text-center">
        <p class="text-lg text-muted">{t("contact.subtitle")}</p>
        <Button href={getRelativeLocaleUrl(lang, "contact")} variant="dark">{t("support.contactCta")}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq > summary::-webkit-details-marker { display: none; }
</style>
